# Enable blur
ro.sf.blurs_are_expensive=1
ro.surface_flinger.supports_background_blur=1

# Bluetooth
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true

# LMKD
ro.lmk.kill_timeout_ms=50
ro.lmk.medium=800
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=30
ro.lmk.thrashing_limit_decay=50
ro.lmk.swap_util_max=100
ro.lmk.swap_free_low_percentage=10

# Device specific properties
import /product/etc/sku/${ro.boot.product.hardware.sku}.prop

# IMS / VoLTE / VoWiFi / VoNR
persist.vendor.radio.volte_enabled=1
persist.vendor.radio.vowifi_enabled=1
persist.vendor.radio.wfc_support=1
persist.vendor.mtk_wfc_support=1
persist.vendor.radio.vonr_enabled=1
persist.vendor.radio.vonr_setting_support=1
ro.vendor.mtk_vonr_support=1
persist.vendor.radio.ims_nr_enabled=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.vilte_support=0
persist.vendor.ims_support=1
persist.vendor.volte_support=1
persist.vendor.mims_support=2
ro.vendor.md_auto_setup_ims=1
